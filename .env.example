# LOCAL secrets — copy to repo-root `.env` (never commit `.env`).
# Real trading stays DISABLED until ALL of the following are true:
#   1) LIVE_TRADING_ENABLED=true
#   2) live.enabled=true in binance_bot.yaml
#   3) live.dry_run=false
#   4) Explicit arming: --live3-arm --authorize-live (+ BINANCE_LIVE3_AUTHORIZED)
#      or --first-trade --authorize-live (+ BINANCE_FIRST_TRADE_AUTHORIZED)
# Credentials alone do NOT enable live trading.

# HARD KILL SWITCH — must remain false until operator authorization
LIVE_TRADING_ENABLED=false

# Force dry-run regardless of YAML (recommended)
DRY_RUN=true

# API key id shown in Binance after you upload your Ed25519 PUBLIC key
BINANCE_API_KEY=

# Absolute path to the Ed25519 PRIVATE key PEM on this server (PKCS#8)
# Example: /home/ubuntu/.config/binance_btc_bot/ed25519_private.pem
BINANCE_ED25519_PRIVATE_KEY_PATH=

# Optional passphrase if the private PEM is encrypted
# BINANCE_ED25519_PRIVATE_KEY_PASSPHRASE=

# Do NOT use BINANCE_API_SECRET for Ed25519 self-generated keys.

# Optional: Telegram operational alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: SMS critical escalation (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Live-arm authorization (leave unset until you intentionally arm)
# BINANCE_LIVE3_AUTHORIZED=
# BINANCE_FIRST_TRADE_AUTHORIZED=
